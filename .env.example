# Copy to .env on each machine. .env is gitignored — secrets never get committed.
# Loaded automatically by the npm scripts (node --env-file-if-exists=.env).

# --- agent (per laptop) ---
NODE_ID=laptop-1
BROKER_URL=ws://192.168.0.10:8787

# --- broker (host machine) ---
# PORT=8787

# --- anything sensitive goes here, never in source ---
# API_TOKEN=
